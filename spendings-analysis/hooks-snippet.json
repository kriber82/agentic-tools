{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh session_start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh prompt" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh stop" } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh tool_start" } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh tool_end" } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.claude/session-logger.sh tool_end" } ] }
    ]
  }
}
